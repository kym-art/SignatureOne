# Database configuration (Supabase PostgreSQL / Prisma)
# Après avoir rempli DATABASE_URL / DIRECT_URL, appliquez la migration incluse :
#   npm install            # installe le CLI Prisma (déclaré en devDependencies)
#   npm run db:migrate     # prisma migrate deploy  (crée tables + colonnes paiement + SmsLog)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API keys & URL
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Client-side Vite compatible aliases (if applicable)
VITE_SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ---------------------------------------------------------------------------
# Intégration plateforme — variables préfixées `kym_`
# Ces variables sont injectées automatiquement par la plateforme de déploiement
# (hébergement managé Supabase/PostgreSQL). Le code les lit en priorité :
#   Client (Vite) : NEXT_PUBLIC_kym_SUPABASE_URL,
#                   NEXT_PUBLIC_kym_SUPABASE_PUBLISHABLE_KEY
#   Serveur (NestJS, scripts) : kym_SUPABASE_URL, kym_SUPABASE_SERVICE_ROLE_KEY
#                   ou kym_SUPABASE_SECRET_KEY, kym_SUPABASE_ANON_KEY
#   Prisma : kym_POSTGRES_PRISMA_URL (repli de DATABASE_URL),
#            kym_POSTGRES_URL_NON_POOLING (repli de DIRECT_URL)
# Sur la plateforme, définissez uniquement les variables kym_* ; en local,
# remplissez plutôt les variables génériques ci-dessus.
# ---------------------------------------------------------------------------

# Application configuration
APP_URL="https://signature-one.vercel.app"

# --- Compte Administrateur (seed au déploiement) ---------------------------
# Ces variables NE SONT PAS préfixées par VITE_ : elles ne sont donc JAMAIS
# inlinées dans le bundle client (le navigateur ne peut pas les lire).
# Uniquement le script serveur `npm run db:seed-admin` les exploite pour créer
# et vérifier le compte admin via Supabase Auth au moment du déploiement.
ADMIN_TELEPHONE="+22890000000"
ADMIN_PASSWORD="ChangezMoiMotDePasseFort123!"
ADMIN_NOM="Directeur Signature One"
# Pendant le build Vercel, `scripts/ci-migrate.mjs` applique automatiquement les
# migrations Prisma puis exécute ce seed d'admin si ces 3 variables sont présentes
# (idempotent : le compte est créé ou son mot de passe resynchronisé).

# Données mockées : developpement uniquement (specifique au client Vite)
# - true  : les donnees d'exemple (produits, commandes, avis, comptes, tables) sont actives
# - false : desactivees (recommandé pour la production)
# Sans valeur, le comportement par defaut s'applique : activees en dev, desactivees en production.
# Pour la production, positionnez la valeur ci-dessous sur "false" (ou laissez le build nous gérer).
# VITE_USE_MOCK_DATA="true"

# --- Backend NestJS (server/) ----------------------------------------------
# Sur Vercel, l'API est hébergée en Serverless Function sur le MÊME domaine
# (cf. api/index.ts + vercel.json) : utilisez une URL relative.
VITE_API_URL="/api"
# Port d'écoute du backend NestJS — lu par server/src/main.ts. Ne PAS utiliser
# la variable générique PORT (utilisée par d'autres processus du projet).
PORT_API=4000
# Secret de signature des JWT backend. DÉFINISSEZ une valeur longue et aléatoire
# en production (le fallback dev est prévisible et ne doit jamais servir en prod).
JWT_SECRET="changez-moi-valeur-longue-et-aleatoire"
# Origine(s) autorisée(s) par le CORS du backend. Défaut restrictif en dev :
# http://localhost:3000 (serveur Vite de ce projet). En production, mettez
# l'origine réelle du frontend, ex. https://signature-one.example.com
# (plusieurs origines : séparées par des virgules, sans espaces).
CORS_ORIGIN="http://localhost:3000"

# CinetPay Payment Gateway configuration (Flooz & TMoney Togo / Mobile Money)
CINETPAY_API_KEY="test_apikey_signatureone_tg"
CINETPAY_SITE_ID="123456"
CINETPAY_SECRET_KEY="test_secretkey_cinetpay"
CINETPAY_SANDBOX="true"
VITE_CINETPAY_SITE_ID="123456"
VITE_CINETPAY_API_KEY="test_apikey_signatureone_tg"
VITE_CINETPAY_SANDBOX="true"

# Optional Gemini AI API key for future assistant features
GEMINI_API_KEY=""

# --- Mobile Money SMS Gateway Webhook (POC) -------------------------------
# Used by the standalone webhook handler (scripts/sms-webhook-handler.ts).
# Set SMS_GATEWAY_WEBHOOK_SECRET to a long random string in production.
SMS_GATEWAY_WEBHOOK_SECRET="dev_secret"
# Port du webhook SMS (variable dédiée — ne pas utiliser PORT générique).
SMS_WEBHOOK_PORT=3001
